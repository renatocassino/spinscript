---
import '@awesome.me/webawesome/dist/styles/webawesome.css';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>SpinScript WASM</title>
		<script is:inline>
			// Applied synchronously, before first paint, to avoid a flash of the
			// wrong theme. spinscript-editor's toggle button reads this same class
			// (and the 'spintheme' key) once it upgrades.
			(function () {
				var saved = localStorage.getItem('spintheme');
				var theme =
					saved === 'light' || saved === 'dark'
						? saved
						: window.matchMedia('(prefers-color-scheme: dark)').matches
							? 'dark'
							: 'light';
				document.documentElement.classList.add(theme === 'dark' ? 'wa-dark' : 'wa-light');
			})();
		</script>
		<style>
			html,
			body {
				margin: 0;
				min-height: 100%;
				background: var(--wa-color-surface-lowered);
				font-family: var(--wa-font-family-body);
			}

			body {
				display: flex;
				justify-content: center;
				padding: var(--wa-space-2xl) var(--wa-space-m);
				box-sizing: border-box;
			}

			spinscript-editor {
				width: 100%;
				max-width: 860px;
			}
		</style>
	</head>
	<body>
		<spinscript-editor></spinscript-editor>
		<script>
			import '../components/spinscript-editor';
		</script>
	</body>
</html>
