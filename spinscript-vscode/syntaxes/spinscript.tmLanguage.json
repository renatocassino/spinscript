{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "SpinScript",
  "scopeName": "source.spin",
  "fileTypes": ["spin"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#fractions" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#notes" },
    { "include": "#variables" },
    { "include": "#parameters" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.spin",
          "match": "//.*$"
        },
        {
          "name": "comment.block.spin",
          "begin": "/\\*",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.begin.spin" }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": { "name": "punctuation.definition.comment.end.spin" }
          }
        }
      ]
    },

    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.spin",
          "begin": "\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.spin" }
          },
          "end": "\"",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.spin" }
          }
        },
        {
          "name": "string.quoted.single.spin",
          "begin": "'",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.spin" }
          },
          "end": "'",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.spin" }
          }
        }
      ]
    },

    "fractions": {
      "comment": "Time notation like 1/4, 1/8 — must be tried before #numbers so the whole fraction is captured as one token instead of just the numerator.",
      "patterns": [
        {
          "name": "constant.numeric.fraction.spin",
          "match": "\\b[0-9]+/[0-9]+\\b"
        }
      ]
    },

    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.spin",
          "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
        }
      ]
    },

    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.spin",
          "match": "\\b(song|loop|beat|play)\\b"
        }
      ]
    },

    "notes": {
      "comment": "Musical notes: a letter A-G, optionally followed by a single octave digit (A4), an accidental (C#, Db), or both (Eb8, F#9). Mirrors Lexer.CheckIsNote.",
      "patterns": [
        {
          "name": "constant.character.note.spin",
          "match": "\\b[A-G](?:[#b][0-9]?|[0-9])?\\b"
        }
      ]
    },

    "variables": {
      "comment": "@name references, inspired by LESS variables: used both where a name is declared (beat @kick, loop @intro, @bpm = ...) and where it is referenced (play @kick;). The 'name' below scopes the whole @name match (including the sigil) as variable.other.readwrite, same trick the bundled LESS grammar uses, so the '@' picks up the variable color instead of staying in the default foreground.",
      "patterns": [
        {
          "match": "(@)([A-Za-z][A-Za-z0-9_]*)",
          "name": "variable.other.readwrite.spin",
          "captures": {
            "1": { "name": "punctuation.definition.variable.spin" },
            "2": { "name": "variable.other.readwrite.spin" }
          }
        }
      ]
    },

    "parameters": {
      "comment": "Named parameters inside ( ), e.g. grid=16, bars=4, repeat=2, swing=0.2 - any identifier immediately followed by '=' inside a parameter/modifier list.",
      "patterns": [
        {
          "name": "variable.parameter.spin",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b(?=\\s*=)"
        }
      ]
    },

    "punctuation": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.spin",
          "match": "="
        },
        {
          "name": "punctuation.terminator.statement.spin",
          "match": ";"
        },
        {
          "name": "punctuation.separator.comma.spin",
          "match": ","
        },
        {
          "name": "punctuation.section.parens.begin.spin",
          "match": "\\("
        },
        {
          "name": "punctuation.section.parens.end.spin",
          "match": "\\)"
        },
        {
          "name": "punctuation.section.braces.begin.spin",
          "match": "\\{"
        },
        {
          "name": "punctuation.section.braces.end.spin",
          "match": "\\}"
        }
      ]
    }
  }
}
